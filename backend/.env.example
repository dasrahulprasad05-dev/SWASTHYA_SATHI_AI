# ============================================
# Swasthya Sathi AI - Backend Environment
# ============================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!

# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Supabase (PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Groq AI
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Twilio SendGrid Transactional Email Service
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_SENDER_EMAIL=your-verified-sender@example.com
SENDGRID_SENDER_NAME="Swasthya Sathi AI - Govt of Odisha"

# Admin & Security
ODISHA_HEALTH_ADMIN_KEY=change-this-to-a-secure-random-key
JWT_SECRET=change-this-to-a-long-random-secret-string
