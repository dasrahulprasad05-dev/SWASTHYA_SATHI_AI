# ============================================
# Swasthya Sathi AI - Backend Configuration
# ============================================

# Server Port & Environment
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Supabase Credentials (PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Groq AI Llama-3 Triage Engine
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Brevo Transactional Email Service (SMTP / REST API)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@swasthyasathi.odisha.gov.in
BREVO_SENDER_NAME="Swasthya Sathi AI - Odisha Health"

# Odisha Health Admin Secret Passkey (For Health Official Registration)
ODISHA_HEALTH_ADMIN_KEY=ODISHA_HEALTH_2026
